[20.687947, "o", "\r\n\u001b[36m▶ mcp__inforce__inforce_check({\"text\": \"Under the Nigeria Tax Act 2025, PAYE in 2026 uses these annual bands: first NGN 800,000 at 0%, next NGN 2,200,000 at 15%, next NGN 9,000,000 at 18%, next NGN 13,000,000 at 21%, next NGN 25,000,000 at 23%, and above NGN 50,000,000 at 25%. Rent relief is 20% of annual rent capped at NGN 500,...)\u001b[0m\r\n"]
[20.71637, "o", "\u001b[32m◀ mcp__inforce__inforce_check: {\"result\":\"{\\\"verdict\\\": \\\"STALE\\\", \\\"on\\\": \\\"2026-11-25\\\", \\\"items\\\": [{\\\"line\\\": 1, \\\"claim\\\": \\\"Nigeria Tax Act\\\", \\\"kind\\\": \\\"citation\\\", \\\"ref\\\": \\\"akn/ng/act/2025/7\\\", \\\"verdict\\\": \\\"IN_FORCE\\\", \\\"verified\\\": false, \\\"endedOn\\\": null, \\\"repealedBy\\\": null, \\\"successor\\\": null, \\\"successorRef\\\": null, \\\"successorStatus\\\": null, \\\"source\\\": null, \\\"path\\\": [\\\"Instrument NTA\\\"], \\\"note\\\": \\\"Act\u001b[0m\r\n"]
